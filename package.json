{
  "name": "nextjs_tailwind_shadcn_ts",
  "version": "0.2.1",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 2>&1 | tee dev.log",
    "build": "node --test scripts/recovery-no-bocao.test.cjs && prisma generate && next build",
    "start": "NODE_ENV=production bun .next/standalone/server.js 2>&1 | tee server.log",
    "lint": "eslint .",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "bun run prisma/seed.ts",
    "check:source": "node scripts/check-source.mjs",
    "check:types": "tsc --noEmit",
    "test:discovery": "node --test scripts/discovery.test.mjs",
    "test:analytics": "node --test scripts/analytics-dashboard.test.cjs scripts/demo-entry.test.cjs",
    "test:upload-limit": "node --test scripts/upload-limit.test.cjs",
    "test:r2-upload": "node --test scripts/r2-upload.test.cjs",
    "test:seo": "node --test scripts/seo-integrations.test.cjs",
    "test:commerce": "node --test scripts/commerce.test.cjs",
    "test:account-experience": "node --test scripts/account-experience.test.cjs",
    "test:member-flow": "node scripts/e2e-member-flow.cjs --prisma-dev",
    "test:download-quota": "node --test scripts/download-quota.test.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1145.0",
    "@aws-sdk/s3-request-presigner": "^3.1145.0",
    "@prisma/client": "^6.11.1",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@tanstack/react-query": "^5.82.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.2",
    "jose": "^6.2.12",
    "lucide-react": "^0.525.0",
    "next": "^16.1.1",
    "next-themes": "^0.4.6",
    "prisma": "^6.11.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
