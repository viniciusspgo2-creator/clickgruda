# Banco de dados — Vercel + Neon PostgreSQL (obrigatório)
# Neon: Dashboard → Connection Details → "Pooled connection" (recomendado p/ runtime)
DATABASE_URL="postgresql://usuario:senha@ep-xxxx-xxxx.sa-east-1.aws.neon.tech/clickgruda?sslmode=require"

# Secret de sessão/auth (gere com: openssl rand -base64 32)
AUTH_SECRET="troque-por-um-segredo-forte"

# Domínio de produção (fixado também em src/lib/site.ts para ignorar URLs antigas da Vercel).
NEXT_PUBLIC_SITE_URL="https://www.clickgruda.com.br"

# Opcionais — SEO / Analytics
NEXT_PUBLIC_GSC_VERIFICATION=""
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_BING_VERIFICATION=""
NEXT_PUBLIC_META_DOMAIN_VERIFICATION=""
# Os mesmos identificadores podem ser configurados no Admin → SEO e Integrações, sem redeploy.

# Conta Admin Master criada pelo seed (rode o seed UMA vez após o 1º deploy)
ADMIN_EMAIL="voce@seudominio.com.br"
ADMIN_PASSWORD="senha-forte-com-12+-caracteres"
